# Local reconstruction workstation. Never place private keys in frontend configuration.
DEPTHCLOUD_HOST=127.0.0.1
DEPTHCLOUD_PORT=8765
DEPTHCLOUD_BUFFER_CAPACITY=10
DEPTHCLOUD_MAXIMUM_BUFFER_SIZE=128
DEPTHCLOUD_BUFFER_MEMORY_MB=128
DEPTHCLOUD_PREVIEW_FPS=24
DEPTHCLOUD_PREVIEW_WIDTH=1280
DEPTHCLOUD_JPEG_QUALITY=82
DEPTHCLOUD_CAMERA_TIMEOUT=8
DEPTHCLOUD_DISCOVERY_MAX_INDEX=5
# Local model directory defaults to backend/.models. No model download is performed.


# Bounded observation storage and CPU work during local inference
DEPTHCLOUD_MAX_SAVED_VIEWS=24
DEPTHCLOUD_SESSION_MEMORY_MB=512
DEPTHCLOUD_INFERENCE_CPU_THREADS=8
